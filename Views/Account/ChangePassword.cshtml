@model ChangePasswordInput
@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="page-heading"><div><span class="eyebrow">Reautenticación</span><h1>Cambiar contraseña</h1><p>Confirma la contraseña y MFA actuales. El cambio revoca las sesiones existentes.</p></div></div>
<form asp-action="ChangePassword" method="post" class="panel form-panel" autocomplete="off"><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid"><label class="field span-2">Contraseña actual<input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" /></label><label class="field span-2">TOTP o recuperación<input asp-for="MfaCode" class="form-control" autocomplete="one-time-code" /></label><label class="field">Nueva contraseña<input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /></label><label class="field">Confirmación<input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /></label></div><button class="btn btn-primary">Cambiar y cerrar sesión</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
