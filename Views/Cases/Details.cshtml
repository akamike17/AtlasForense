@model ForensicCase
@{ ViewData["Title"] = Model.Folio; var step = Model.Status switch { CaseStatus.Draft => 1, CaseStatus.Authorized or CaseStatus.Acquiring => 2, CaseStatus.Analyzing => 3, _ => 4 }; }
<div class="page-heading"><div><span class="eyebrow">@Model.Folio · @Model.RequestingOrganization</span><h1>@Model.Title</h1><p>@Model.Scope</p></div><span class="status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<nav class="stage-nav" aria-label="Etapas forenses">
@for (var i=1; i<=4; i++) { var labels = new[]{"Preparación","Adquisición","Análisis","Informe"}; <div class="stage @(i < step ? "done" : i == step ? "active" : "")"><b>@(i < step ? "✓" : i)</b><span>@labels[i-1]</span></div> }
</nav>

<section class="panel stage-panel @(step == 1 ? "current" : "")"><div class="panel-heading"><div><span class="eyebrow">Etapa 1</span><h2>Preparación y autorización</h2></div><span class="check">@(Model.Authorization is null ? "Pendiente" : "Completada")</span></div>
<div class="summary-grid"><div><small>Examinador</small><strong>@Model.LeadExaminer</strong></div><div><small>Creado UTC</small><strong>@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</strong></div>@if(Model.Authorization is not null){<div><small>Autoridad</small><strong>@Model.Authorization.Authority</strong></div><div><small>Referencia</small><strong>@Model.Authorization.Reference</strong></div>}</div>
@if(Model.Status == CaseStatus.Draft){<form asp-action="Authorize" method="post" class="form-grid compact"><input type="hidden" name="CaseId" value="@Model.Id"/><label class="field">Autoridad competente<input name="Authority" class="form-control" required maxlength="160"/></label><label class="field">Orden / referencia<input name="Reference" class="form-control" required maxlength="160"/></label><label class="field">Aprobado por<input name="ApprovedBy" class="form-control" required maxlength="120"/></label><label class="field">Limitaciones<input name="Limitations" class="form-control" maxlength="1000"/></label><button class="btn btn-primary span-2">Autorizar alcance</button></form>}
</section>

<section class="panel stage-panel @(step == 2 ? "current" : "")"><div class="panel-heading"><div><span class="eyebrow">Etapa 2</span><h2>Adquisición y preservación</h2></div><span class="check">@Model.Evidence.Count evidencia(s)</span></div>
@if(Model.Status is CaseStatus.Authorized or CaseStatus.Acquiring){<form asp-action="Acquire" method="post" enctype="multipart/form-data" class="form-grid compact"><input type="hidden" name="CaseId" value="@Model.Id"/><label class="field span-2">Archivo de evidencia (máximo 100 MB)<input type="file" name="File" class="form-control" required/></label><label class="field span-2">Descripción<input name="Description" class="form-control" required maxlength="500"/></label><label class="field">Tipo de fuente<input name="SourceType" class="form-control" placeholder="Disco, memoria, registro, red…" required/></label><label class="field">Ubicación de origen<input name="SourceLocation" class="form-control" required/></label><label class="field">Adquirida por<input name="AcquiredBy" class="form-control" required/></label><label class="field">Método / herramienta<input name="AcquisitionMethod" class="form-control" required/></label><button class="btn btn-primary span-2">Adquirir, calcular SHA-256 y preservar</button></form>}
@foreach(var evidence in Model.Evidence){<article class="evidence-card"><div><span class="eyebrow">@evidence.Identifier</span><h3>@evidence.Description</h3><p>@evidence.OriginalFileName · @evidence.SizeBytes.ToString("N0") bytes · @evidence.AcquisitionMethod</p><code class="hash">SHA-256 @evidence.Sha256</code>@if(Model.Status == CaseStatus.Analyzing){<form asp-action="AnalyzeEvidence" method="post" class="inline-action"><input type="hidden" name="caseId" value="@Model.Id"/><input type="hidden" name="evidenceId" value="@evidence.Id"/><input name="actor" class="form-control" placeholder="Analista" required/><button class="btn btn-sm btn-primary">Análisis estático seguro</button></form>}</div><details><summary>Cadena de custodia (@evidence.ChainOfCustody.Count)</summary>@foreach(var movement in evidence.ChainOfCustody){<p><strong>@movement.Action</strong> · @movement.PerformedBy · @movement.OccurredAtUtc.ToString("u")<br/><small>@movement.Location — @movement.Notes</small></p>}<form asp-action="AddCustody" method="post" class="form-grid compact"><input type="hidden" name="CaseId" value="@Model.Id"/><input type="hidden" name="EvidenceId" value="@evidence.Id"/><input name="Action" class="form-control" placeholder="Acción" required/><input name="PerformedBy" class="form-control" placeholder="Responsable" required/><input name="Location" class="form-control" placeholder="Ubicación" required/><input name="Notes" class="form-control" placeholder="Notas"/><button class="btn btn-sm btn-outline-light span-2">Registrar movimiento</button></form></details></article>}
@if(Model.Status == CaseStatus.Acquiring){<form asp-action="StartAnalysis" method="post" class="inline-action"><input type="hidden" name="id" value="@Model.Id"/><input name="actor" class="form-control" placeholder="Analista responsable" required/><button class="btn btn-primary">Cerrar adquisición e iniciar análisis</button></form>}
</section>

<section class="panel stage-panel @(step == 3 ? "current" : "")"><div class="panel-heading"><div><span class="eyebrow">Etapa 3</span><h2>Análisis y correlación</h2></div><span class="check">@Model.Findings.Count hallazgo(s)</span></div>
@if(Model.Status == CaseStatus.Analyzing){<form asp-action="AddFinding" method="post" class="form-grid compact"><input type="hidden" name="CaseId" value="@Model.Id"/><label class="field">Título<input name="Title" class="form-control" required/></label><label class="field">Severidad<select name="Severity" class="form-select" asp-items="Html.GetEnumSelectList<FindingSeverity>()"></select></label><label class="field span-2">Descripción<textarea name="Description" class="form-control" required></textarea></label><label class="field span-2">Detalles técnicos<textarea name="TechnicalDetails" class="form-control" required></textarea></label><label class="field">Referencias de evidencia<input name="EvidenceReferences" class="form-control" placeholder="AF-…-E001" required/></label><label class="field">Analista<input name="Analyst" class="form-control" required/></label><button class="btn btn-primary span-2">Registrar hallazgo</button></form>}
@foreach(var finding in Model.Findings){<article class="finding"><span class="severity severity-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span><div><h3>@finding.Title</h3><p>@finding.Description</p><small>Evidencia: @finding.EvidenceReferences · @finding.Analyst</small></div></article>}
@if(Model.AnalysisRuns.Count > 0){<div class="analysis-dashboard"><div><strong>@Model.AnalysisRuns.Count</strong><span>Ejecuciones</span></div><div><strong>@Model.Artifacts.Count</strong><span>Artefactos</span></div><div><strong>@Model.Indicators.Count</strong><span>IOC</span></div><div><strong>@Model.Events.Count</strong><span>Eventos</span></div></div><div class="ioc-list">@foreach(var indicator in Model.Indicators.Take(100)){<div><span class="severity">@indicator.Type</span><code>@indicator.Value</code><small>@indicator.Confidence</small></div>}</div>}
</section>

<section class="panel stage-panel @(step == 4 ? "current" : "")"><div class="panel-heading"><div><span class="eyebrow">Etapa 4</span><h2>Informe, revisión y cierre</h2></div><span class="check">@(Model.Report is null ? "Pendiente" : "Sellado")</span></div>
@if(Model.Status == CaseStatus.Analyzing && Model.Findings.Count > 0){<form asp-action="PrepareReport" method="post" class="form-grid compact"><input type="hidden" name="CaseId" value="@Model.Id"/><label class="field span-2">Resumen ejecutivo<textarea name="ExecutiveSummary" class="form-control" required></textarea></label><label class="field span-2">Metodología<textarea name="Methodology" class="form-control" required></textarea></label><label class="field span-2">Conclusiones<textarea name="Conclusions" class="form-control" required></textarea></label><label class="field span-2">Recomendaciones<textarea name="Recommendations" class="form-control" required></textarea></label><label class="field span-2">Preparado por<input name="PreparedBy" class="form-control" required/></label><button class="btn btn-primary span-2">Generar y sellar informe</button></form>}
@if(Model.Report is not null){<div class="report-ready"><div><h3>Informe íntegro disponible</h3><code class="hash">@Model.Report.IntegrityHash</code></div><a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-outline-light">Vista imprimible</a></div>@if(Model.Status == CaseStatus.Reporting){<form asp-action="Close" method="post" class="inline-action"><input type="hidden" name="id" value="@Model.Id"/><input name="actor" class="form-control" placeholder="Responsable del cierre" required/><button class="btn btn-danger">Cerrar y sellar expediente</button></form>}}
</section>

<section class="panel"><div class="panel-heading"><div><span class="eyebrow">Registro inmutable encadenado</span><h2>Auditoría</h2></div><span class="check">@Model.AuditTrail.Count eventos</span></div><div class="timeline">@foreach(var audit in Model.AuditTrail.OrderByDescending(x=>x.Sequence)){<div><b>@audit.Sequence</b><p><strong>@audit.Action</strong> · @audit.Actor<br/><span>@audit.Detail</span><br/><code>@audit.EntryHash[..16]…</code></p><time>@audit.OccurredAtUtc.ToString("u")</time></div>}</div></section>
